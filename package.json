{
  "name": "emberhold",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Emberhold — an original base-builder & asynchronous raid game (vertical slice).",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @coc/client --filter @coc/server dev",
    "dev:client": "pnpm --filter @coc/client dev",
    "dev:server": "pnpm --filter @coc/server dev",
    "dev:tools": "pnpm --filter @coc/tools dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "pnpm -r build",
    "verify": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.15.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^3.2.7"
  }
}
