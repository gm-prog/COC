{
  "name": "@coc/server",
  "version": "0.1.0",
  "private": true,
  "description": "Emberhold API server — Fastify, imports the same sim-core the client uses.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@coc/game-data": "workspace:*",
    "@coc/protocol": "workspace:*",
    "@coc/sim-core": "workspace:*",
    "fastify": "^5.12.7"
  },
  "devDependencies": {
    "tsx": "^4.23.15"
  }
}
