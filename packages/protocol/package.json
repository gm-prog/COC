{
  "name": "@coc/protocol",
  "version": "0.1.0",
  "private": true,
  "description": "Shared wire types for Emberhold's HTTP + WebSocket API. Used by both the client and the server so the two can never drift.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "watch": "tsc --noEmit -p tsconfig.json --watch"
  },
  "dependencies": {},
  "devDependencies": {},
  "sideEffects": false
}
