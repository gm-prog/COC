{
  "name": "@coc/game-data",
  "version": "0.1.0",
  "private": true,
  "description": "Data-driven balance tables for Emberhold (buildings, troops, spells, unlocks) plus the generator scripts that produce them.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "dist",
    "data"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "watch": "tsc --noEmit -p tsconfig.json --watch",
    "gen:balance": "tsx scripts/gen-balance.ts"
  },
  "dependencies": {},
  "devDependencies": {}
}
